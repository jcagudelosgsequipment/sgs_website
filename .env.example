# SharePoint / Microsoft Graph
SP_TENANT_ID=
NEXT_PUBLIC_SP_CLIENT_ID=
SP_CLIENT_SECRET=
SP_SITE_URL=
SP_LIST_NAME=

# SMTP (Nodemailer) — cotizaciones web
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Contact form recipient (defaults to sales@sgsequipment.com if unset)
CONTACT_TO=sales@sgsequipment.com

# Entorno (development activa bypass de reCAPTCHA en localhost)
NODE_ENV=development

# Google reCAPTCHA v2/v3 (frontend site key — use "test" for local dev bypass)
VITE_RECAPTCHA_SITE_KEY=test

# Google reCAPTCHA (backend secret — use "test" or leave empty for local dev bypass)
RECAPTCHA_SECRET_KEY=test
